# private case data — personal financial/residential info, never commit
# (see case/README.md and SCHEMA.md §0)
case/profile.md
case/case-index.md
case/cases/*.md
case/archived/*.md
case/fieldnotes/*.md
case/보드.md
!case/cases/.gitkeep
!case/archived/.gitkeep
!case/fieldnotes/.gitkeep

# batch sync debug dumps — raw, unverified API responses, not curated raw/ sources
raw/_api-debug/

# Obsidian — keep shareable config (community-plugins.json, snippets, graph
# color groups, per-plugin data.json 설정 — 예: Templater의 온보딩
# startup_templates), but don't vendor 3rd-party plugin *code* into a public
# repo — install listed plugins via Community Plugins browser instead
# (README.md 표 참고). data.json은 설정이라 유지, main.js/styles.css만 제외.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# local CLI state (MOTD snapshot etc.) — machine-local, not curated content
.local/

# editors / os
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
